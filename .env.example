# 环境变量配置
# 复制本文件为 .env 并根据需要修改

# ============================================
# 通用配置
# ============================================
NODE_ENV=development
ENVIRONMENT=development
DEBUG=true

# ============================================
# 前端配置 (apps/web)
# ============================================
NEXT_PUBLIC_API_URL=http://localhost:8100
NEXT_PUBLIC_APP_NAME=数学试卷六维分析系统
NEXT_PUBLIC_APP_VERSION=0.1.0

# ============================================
# 后端配置 (apps/api)
# ============================================

# 应用配置
APP_NAME=数学试卷六维分析系统
APP_VERSION=0.1.0
APP_HOST=0.0.0.0
APP_PORT=8100
APP_WORKERS=2
MAX_RUNNING_ANALYSIS_TASKS=2
MAX_QUEUED_ANALYSIS_TASKS=10

# 安全配置
SECRET_KEY=your-secret-key-change-this-in-production
JWT_SECRET_KEY=your-jwt-secret-key-change-this
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# 数据库配置
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/math_analysis
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=math_analysis
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# 数据库连接池
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT=15
DB_POOL_RECYCLE=1800

# Redis配置
REDIS_URL=redis://localhost:6379/0
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# Celery配置
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
CELERY_TASK_ALWAYS_EAGER=false
CELERY_RESULT_EXPIRES=86400
CELERY_WORKER_CONCURRENCY=2
CELERY_WORKER_MAX_TASKS_PER_CHILD=20
TASK_STALE_MINUTES=60
ANALYSIS_SLOT_RETRY_SECONDS=10
ANALYSIS_SLOT_TTL_SECONDS=900
ANALYSIS_SLOT_HEARTBEAT_SECONDS=60

# OCR配置
OCR_PROVIDER=vision_llm
OCR_TIMEOUT=30
OCR_MAX_RETRIES=3
VISION_LLM_MODEL=
VISION_LLM_CONCURRENCY=5
VISION_LLM_PAGE_TIMEOUT=90
VISION_LLM_RENDER_DPI=180
VISION_LLM_MAX_TOKENS=12000
QUESTION_LLM_CONCURRENCY=15
QUESTION_LLM_MAX_TOKENS=2800
QUESTION_LLM_TIMEOUT_SECONDS=75
GLOBAL_LLM_CONCURRENCY=40
GLOBAL_VISION_LLM_CONCURRENCY=15
GLOBAL_QUESTION_LLM_CONCURRENCY=30
GLOBAL_LLM_ACQUIRE_TIMEOUT_SECONDS=120
GLOBAL_LLM_RETRY_INTERVAL_SECONDS=0.5
GLOBAL_LLM_SLOT_TTL_SECONDS=300
PADDLE_OCR_LANG=ch
PADDLE_OCR_USE_ANGLE_CLS=true
PADDLE_OCR_USE_GPU=false
PADDLE_OCR_MODEL_DIR=./data/paddleocr

# 百度OCR (可选)
BAIDU_OCR_API_KEY=
BAIDU_OCR_SECRET_KEY=

# 阿里OCR (可选)
ALI_OCR_ACCESS_KEY=
ALI_OCR_ACCESS_SECRET=

# 文件上传配置
MAX_UPLOAD_SIZE=52428800
MAX_PDF_PAGES=6
MAX_IMAGE_COUNT=20
SINGLE_IMAGE_MAX_SIZE=10485760
ALLOWED_EXTENSIONS=[".pdf",".jpg",".jpeg",".png"]
UPLOAD_DIR=/app/uploads
REPORT_OUTPUT_DIR=/app/reports

# PDF导出配置
PLAYWRIGHT_BROWSER_PATH=/usr/bin/chromium

# 日志配置
LOG_LEVEL=INFO
LOG_FORMAT=json

# CORS配置
CORS_ORIGINS=["http://localhost:3100","http://127.0.0.1:3100"]
CORS_ALLOW_CREDENTIALS=true

# ============================================
# Docker 配置
# ============================================
COMPOSE_PROJECT_NAME=math-analysis
DOCKER_REGISTRY=
DOCKER_TAG=latest
MATH_ANALYSIS_DATA_DIR=./.deploy-data
WEB_PORT=3000
API_PORT=8100
